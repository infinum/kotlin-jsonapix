{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>infinum/android-renovate-config"
  ],
  "reviewers": [
    "thisAAY",
    "DrakslerT"
  ],
  "packageRules": [
    {
      "description": "kctfork is built against one Kotlin compiler version, so it is upgraded together with Kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin:**",
        "dev.zacsweers.kctfork:**"
      ],
      "groupName": "Kotlin and kctfork",
      "separateMajorMinor": false
    }
  ]
}
